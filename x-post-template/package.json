{
  "name": "x-post-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A template for a post video (X, Twitter) of typing that behaves like ink, drawn frame by frame by the If This Finds You handwriting engine in Remotion.",
  "license": "MIT",
  "scripts": {
    "session": "node scripts/node-ts.mjs scripts/ink-session.ts",
    "hands": "node scripts/node-ts.mjs scripts/hand-session.ts",
    "recorder": "node scripts/build-recorder.mjs",
    "take": "node scripts/node-ts.mjs scripts/take.ts",
    "every": "node scripts/node-ts.mjs scripts/ink-every.ts",
    "draft:every": "remotion render src/index.ts InkEvery out/draft-every-540.mp4 --scale=0.5 --crf=24",
    "render:every": "remotion render src/index.ts InkEvery out/ink-every-1080.mp4",
    "studio": "remotion studio src/index.ts",
    "draft": "remotion render src/index.ts InkDemo out/draft-540.mp4 --scale=0.5 --crf=24",
    "render": "remotion render src/index.ts InkDemo out/x-post-1080.mp4",
    "draft:hands": "remotion render src/index.ts InkDemoHands out/draft-hands-540.mp4 --scale=0.5 --crf=24",
    "render:hands": "remotion render src/index.ts InkDemoHands out/x-post-hands-1080.mp4",
    "take:pose": "node scripts/node-ts.mjs scripts/take-pose.ts",
    "draft:take": "remotion render src/index.ts TakeHands out/draft-take-hands-540.mp4 --scale=0.5 --crf=24",
    "render:take": "remotion render src/index.ts TakeHands out/take-hands-1080.mp4",
    "still": "remotion still src/index.ts InkDemo out/still.png --frame=1180"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540",
    "three": "0.181.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/three": "0.181.0",
    "esbuild": "0.28.1"
  }
}

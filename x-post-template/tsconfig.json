{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "baseUrl": ".",
    "paths": { "@engine": ["../engine/index.js"], "@/*": ["../app/src/*"] }
  },
  "include": ["src", "scripts", "recorder", "remotion.config.ts"]
}
